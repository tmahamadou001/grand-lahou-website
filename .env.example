# Copy to .env before running `docker compose up -d`.
# These values are for local development only — never reuse them in production.

WP_PORT=8080

DB_NAME=grandlahou
DB_USER=grandlahou
DB_PASSWORD=grandlahou
DB_ROOT_PASSWORD=root

# 1 en développement, 0 en production
WP_DEBUG=1

# Utilisés par `make install` pour créer le compte administrateur local
WP_URL=http://localhost:8080
WP_TITLE=Mairie de Grand-Lahou
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=contact@mairie-grandlahou.ci
